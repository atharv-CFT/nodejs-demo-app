# Copy this file to .env and adjust values as needed.
# .env is git-ignored — real secrets should never be committed.

# Node app
PORT=5000

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change_me_strong_password
MONGO_DB_NAME=mydatabase

# Full connection string the app uses (built from the vars above by docker-compose)
MONGO_URL=mongodb://admin:change_me_strong_password@mongo:27017/mydatabase?authSource=admin
